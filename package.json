{
  "name": "market-calendar",
  "version": "1.1.1",
  "description": "Exchange trading calendars: sessions, holidays, early closes and bar timestamps for 36 markets. A JavaScript port of pandas_market_calendars.",
  "keywords": [
    "market-calendar",
    "trading-calendar",
    "exchange-calendar",
    "trading-hours",
    "market-hours",
    "is-market-open",
    "trading-days",
    "market-holidays",
    "early-close",
    "stock-market",
    "finance",
    "quantitative-finance",
    "algorithmic-trading",
    "backtesting",
    "nyse",
    "nasdaq",
    "cme",
    "lse",
    "jpx",
    "hkex",
    "pandas-market-calendars",
    "typescript",
    "luxon"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaeleeps/market-calendar.git"
  },
  "homepage": "https://github.com/jaeleeps/market-calendar#readme",
  "bugs": {
    "url": "https://github.com/jaeleeps/market-calendar/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write .",
    "test": "tsx japaFile.ts",
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.check.json",
    "prepare": "husky",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@japa/assert": "^4.0.1",
    "@japa/runner": "^4.2.0",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.37.0",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "japa": "^4.0.0",
    "lint-staged": "^16.1.5",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.37.0"
  },
  "dependencies": {
    "@types/luxon": "^3.7.1",
    "luxon": "^3.7.1"
  },
  "author": "Jaeyoung Lee <jaeleeps@gmail.com>"
}
